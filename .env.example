GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: increases public-repo rate limit if set (no scopes needed)
GITHUB_TOKEN=

# Required only for the "Connect GitHub" picker flow.
# Register an OAuth App at https://github.com/settings/applications/new
# Authorization callback URL: http://localhost:8787/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random string for signing the session cookie
SESSION_SECRET=change-me-to-a-long-random-string

# URL the OAuth callback redirects back to (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
PORT=8787
